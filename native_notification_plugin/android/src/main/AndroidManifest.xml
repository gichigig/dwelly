<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ishinadwelly.native_notification_plugin">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    
    <application>
        <receiver
            android:name="com.ishinadwelly.native_notification_plugin.ReplyReceiver"
            android:exported="false" />
        <receiver
            android:name="com.ishinadwelly.native_notification_plugin.CallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ishinadwelly.action.DECLINE_CALL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
